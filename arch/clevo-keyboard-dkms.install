post_install() {
  dkms install -m clevo-keyboard -v 1.0.0
  udevadm control --reload-rules >/dev/null 2>&1 || true
  udevadm trigger >/dev/null 2>&1 || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
}

pre_upgrade() {
  pre_remove "$2"
}

post_upgrade() {
  post_install "$1"
}

pre_remove() {
  dkms remove -m clevo-keyboard -v 1.0.0 --all >/dev/null 2>&1 || true
}
